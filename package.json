{
  "name": "kampongshare-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Community donation and volunteer platform for Singapore (hackathon prototype)",
  "scripts": {
    "dev:css": "npx @tailwindcss/cli -i ./src/input.css -o ./css/style.css --watch",
    "chat-help": "node scripts/build-chat-help.js",
    "check:i18n": "node scripts/check-i18n.js",
    "build": "npm run chat-help && npx @tailwindcss/cli -i ./src/input.css -o ./css/style.css --minify",
    "seed": "node scripts/seed.js"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/cli": "^4.3.3",
    "netlify-cli": "^27.14.2",
    "tailwindcss": "^4.3.3"
  }
}
