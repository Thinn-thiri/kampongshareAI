# Copy this file to .env and fill in your own values. Never commit .env.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public anon key — the same one as in js/config.js (used by the share-event link previews)
SUPABASE_ANON_KEY=
SUPABASE_DB_PASSWORD=
NVIDIA_API_KEY=
# Optional OneMap account for postal code lookup (free: https://www.onemap.gov.sg/apidocs/register)
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
# One shared password for every demo account made by scripts/seed.js (at least 8 characters)
DEMO_PASSWORD=
